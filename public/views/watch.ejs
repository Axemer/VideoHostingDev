<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/watch_style.css">
    <title><%= video.title %></title>
</head>
<body>
    <header>
        <nav>
            <a href="/">Главная</a>
            <a href="/profile">Профиль</a>
        </nav>
    </header>

    <div class="container">
        <!-- Main Content -->
        <div class="main-content">
            <div class="video-player">
                <video src="<%= path %>" controls></video>
            </div>
            <div class="video-info">
                <h1><%= video.title %></h1>
                <div class="buttons">
                    <button>👍 <%= video.likes %></button>
                    <button>👎 <%= video.dislikes %></button>
                </div>
                <div class="channel-info">
                    <img src="<%= video.channelIcon %>" alt="Channel Icon">
                    <div>
                        <p><strong><%= video.channelName %></strong></p>
                        <p><%= video.subscribers %> подписчиков</p>
                        <button>Подписаться</button>
                    </div>
                </div>
                <p><%= video.views %> просмотров</p>
                <p>Добавлено: <%= uploadDate %></p>
                <div class="description">
                    <p id="description-text"><%= video.description %></p>
                    <button onclick="toggleDescription(event)">Показать больше</button>
                </div>
            </div>

            <!-- Comment section -->
            <div class="comments-section">
                <h2>Комментарии</h2>
                <textarea placeholder="Оставьте комментарий..."></textarea>
                <button>Отправить</button>
                <div class="comments">
                    <% if (comments.length > 0) { %>
                        <% comments.forEach(comment => { %>
                            <p><strong><%= comment.author %></strong>: <%= comment.text %></p>
                        <% }); %>
                    <% } else { %>
                        <p>Нет комментариев. Напишите первый комментарий!</p>
                    <% } %>
                </div>
                
            </div>

        </div>

        <!-- Suggested Videos -->
        <div class="suggested-videos">
            <h2>Другие видео</h2>
            <ul>
                <% suggestedVideos.forEach(video => { %>
                    <div class="video-item">
                        <a href="/watch/<%= video.id %>">
                            <div class="thumbnail">
                                <img src="<%= video.thumbnail %>" alt="<%= video.title %>">
                                <span class="duration"><%= video.duration %></span>
                            </div>
                            <h3><%= video.title %></h3>
                            <p>Автор: <%= video.author %></p>
                            <p>Просмотры: <%= video.views %></p>
                        </a>
                    </div>
                <% }); %>
            </ul>
        </div>
    </div>

    <script>
        function toggleDescription(e) {
            const description = document.getElementById('description-text');
            const button = e.target;
            if (button.innerText === 'Показать больше') {
                description.style.whiteSpace = 'normal';
                button.innerText = 'Свернуть';
            } else {
                description.style.whiteSpace = 'nowrap';
                button.innerText = 'Показать больше';
            }
        }
    </script>
</body>
</html>
